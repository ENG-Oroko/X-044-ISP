generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  PLATFORM_SUPPORT

  ISP_ADMIN
  TECHNICIAN
  TENANT_SUPPORT

  CUSTOMER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
  DISABLED
}

enum DeviceType {
  MIKROTIK
  OLT
  SWITCH
  ACCESS_POINT
  SERVER
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
  DISABLED
}

enum CustomerType {
  PPPOE
  HOTSPOT
  BOTH
}

enum CustomerStatus {
  ACTIVE
  SUSPENDED
  PENDING
  DISCONNECTED
}

enum PlanType {
  PPPOE
  HOTSPOT
  HYBRID
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  MPESA
  CARD
  AIRTEL
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

model Tenant {
  id                String             @id @default(uuid())

  name              String             @unique

  email             String?
  phone             String?

  logo              String?

  isActive          Boolean            @default(true)

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  users             User[]
  devices           Device[]
  customers         Customer[]
  plans             Plan[]
  pppoeAccounts     PppoeAccount[]
  hotspotAccounts   HotspotAccount[]
  invoices          Invoice[]
  payments          Payment[]

  @@index([name])

  @@map("tenants")
}

model User {
  id                  String          @id @default(uuid())

  tenantId            String?
  tenant              Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  fullName            String

  email               String
  phone               String?

  passwordHash        String

  role                Role            @default(CUSTOMER)

  status              UserStatus      @default(ACTIVE)

  avatar              String?

  lastLoginAt         DateTime?

  isEmailVerified     Boolean         @default(false)

  refreshToken        String?

  deletedAt           DateTime?

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@unique([tenantId, email])
  @@unique([tenantId, phone])

  @@index([tenantId])
  @@index([role])
  @@index([status])

  @@map("users")
}

model Device {
  id                  String          @id @default(uuid())

  tenantId            String
  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name                String

  serialNumber        String

  macAddress          String?

  ipAddress           String?

  model               String?

  brand               String?         @default("MikroTik")

  deviceType          DeviceType      @default(MIKROTIK)

  status              DeviceStatus    @default(OFFLINE)

  username            String?

  encryptedPassword   String?

  apiPort             Int?            @default(8729)

  sshPort             Int?            @default(22)

  location            String?

  description         String?

  firmwareVersion     String?

  lastSeenAt          DateTime?

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  pppoeAccounts       PppoeAccount[]
  hotspotAccounts     HotspotAccount[]

  @@unique([tenantId, serialNumber])

  @@index([tenantId])
  @@index([deviceType])
  @@index([status])

  @@map("devices")
}

model Customer {
  id                  String              @id @default(uuid())

  tenantId            String
  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  fullName            String

  email               String?
  phone               String

  nationalId          String?

  address             String?

  customerType        CustomerType

  status              CustomerStatus      @default(PENDING)

  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  pppoeAccounts       PppoeAccount[]
  hotspotAccounts     HotspotAccount[]

  invoices            Invoice[]
  payments            Payment[]

  @@unique([tenantId, phone])
  @@unique([tenantId, email])

  @@index([tenantId])
  @@index([status])

  @@map("customers")
}

model Plan {
  id                  String          @id @default(uuid())

  tenantId            String
  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name                String

  planType            PlanType

  price               Float

  uploadSpeed         Int
  downloadSpeed       Int

  validityDays        Int

  mikrotikProfile     String?

  description         String?

  isActive            Boolean         @default(true)

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  pppoeAccounts       PppoeAccount[]
  hotspotAccounts     HotspotAccount[]

  @@unique([tenantId, name])

  @@index([tenantId])
  @@index([planType])

  @@map("plans")
}

model PppoeAccount {
  id                  String          @id @default(uuid())

  tenantId            String
  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  customerId          String
  customer            Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)

  deviceId            String
  device              Device          @relation(fields: [deviceId], references: [id])

  planId              String
  plan                Plan            @relation(fields: [planId], references: [id])

  username            String

  passwordHash        String

  profileName         String?

  ipAddress           String?

  macAddress          String?

  isActive            Boolean         @default(true)

  installedAt         DateTime?

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@unique([tenantId, username])

  @@index([tenantId])
  @@index([customerId])
  @@index([deviceId])

  @@map("pppoe_accounts")
}

model HotspotAccount {
  id                  String          @id @default(uuid())

  tenantId            String
  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  customerId          String
  customer            Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)

  deviceId            String
  device              Device          @relation(fields: [deviceId], references: [id])

  planId              String
  plan                Plan            @relation(fields: [planId], references: [id])

  username            String

  passwordHash        String

  voucherCode         String?

  dataLimitMb         BigInt?

  timeLimitMinutes    Int?

  expiresAt           DateTime?

  isActive            Boolean         @default(true)

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@unique([tenantId, username])

  @@index([tenantId])
  @@index([customerId])
  @@index([deviceId])

  @@map("hotspot_accounts")
}

model Invoice {
  id                  String            @id @default(uuid())

  tenantId            String
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  customerId          String
  customer            Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)

  invoiceNumber       String

  amount              Float

  tax                 Float             @default(0)

  totalAmount         Float

  dueDate             DateTime

  status              InvoiceStatus     @default(PENDING)

  notes               String?

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  payments            Payment[]

  @@unique([tenantId, invoiceNumber])

  @@index([tenantId])
  @@index([customerId])
  @@index([status])

  @@map("invoices")
}

model Payment {
  id                  String            @id @default(uuid())

  tenantId            String
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  customerId          String
  customer            Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)

  invoiceId           String
  invoice             Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amount              Float

  paymentMethod       PaymentMethod

  providerReference   String?

  status              PaymentStatus     @default(PENDING)

  paidAt              DateTime?

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([tenantId])
  @@index([customerId])
  @@index([invoiceId])
  @@index([status])

  @@map("payments")
}